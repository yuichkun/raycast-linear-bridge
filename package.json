{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-linear-bridge",
  "title": "Linear Bridge",
  "description": "A fast, offline-first, keyboard-driven task list for Raycast backed by Linear",
  "icon": "command-icon.png",
  "author": "yuichkun",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "list-tasks",
      "title": "List Tasks",
      "description": "lists your Linear tasks",
      "mode": "view"
    },
    {
      "name": "create-task",
      "title": "Create Task",
      "description": "creates a new task, local-only by default",
      "mode": "view"
    },
    {
      "name": "archive-completed",
      "title": "Archive Completed Tasks",
      "description": "archives all completed tasks",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "linearApiKey",
      "title": "Linear Personal API Key",
      "description": "Personal API Key issued from Linear (Settings > Account > Security & Access). Must NOT be team-restricted, since this extension reads issues across all your teams.",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@linear/sdk": "^90.0.0",
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.0",
    "fuse.js": "^7.5.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.9.3",
    "@types/react": "^19.1.8",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "ray build -e dist",
    "test": "vitest",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
