{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-linear-bridge",
  "title": "Linear Bridge",
  "description": "A fast, offline-first, keyboard-driven task list for Raycast backed by Linear",
  "icon": "command-icon.png",
  "author": "yuichkun",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "list-tasks",
      "title": "List Tasks",
      "description": "lists your Linear tasks",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.9.3",
    "@types/react": "^19.1.8",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
